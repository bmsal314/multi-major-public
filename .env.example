# Separate values/projects for development, staging and production. Never commit real values.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Only internal workers/maintenance use this privileged key; never a NEXT_PUBLIC variable.
SUPABASE_SECRET_KEY=
INTERNAL_API_SECRET=
CRON_SECRET=
ENGINE_URL=http://127.0.0.1:8000
# Production requires CAPTCHA + custom SMTP configured in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set to true only after SMTP, confirmation and recovery are verified on staging.
AUTH_EMAIL_READY=false
VERCEL_QUEUE_REGION=iad1
# Optional local embedded queue endpoint. Do not set in production.
VERCEL_QUEUE_BASE_URL=
