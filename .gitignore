# Python
__pycache__/
*.pyc
.pytest_cache/

# Local backend environment
backend/.venv/

# Frontend deps
frontend/node_modules/
frontend/.next/
frontend/tsconfig.tsbuildinfo

# OS/editor
.DS_Store
.vscode/

# Runtime and local artifacts
*.log
tmp/

# Student audit data — never commit. These contain a name, student ID,
# GPA, and a full transcript.
*.pdf
DARS/

# The parser lexicon is generated by scripts/grow_lexicon.py but ships with
# the app as a read-only prior, so it is tracked deliberately.
!backend/data/lexicon.json

# Local plan storage
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# Local editor/tooling state: machine-specific permissions and preview config
.claude/worktrees/
.claude/settings.local.json
.claude/launch.json

# Hosted credentials and publication artifacts
.env
.env.*
!.env.example
!**/.env.example
.vercel/
release/
private-release/
coverage/
playwright-report/
test-results/
*.backup
